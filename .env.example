# Telegram
BOT_TOKEN=

# AI Provider: "groq", "cerebras", or "gemini"
AI_PROVIDER=groq

# API Keys
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=

# ── Context Classification (Pass 2) ─────────────────────────────────────────
# When true, the LLM proposes ADDITIONAL evidence-backed classifications
# (Geography / SaaS Experience / Market Segment) on top of the deterministic
# rules. The AI can only ADD tags backed by verbatim resume quotes — it never
# overrides the deterministic baseline. Default: false (deterministic only).
AI_CLASSIFICATION_ENABLED=false

# Google Drive — path to service account JSON credentials file
GOOGLE_DRIVE_CREDENTIALS=

# Serverless (Vercel) only: paste the FULL service-account JSON here instead.
# On ephemeral disks there is no file to point at — the webhook writes this
# to a temp file at startup. Leave GOOGLE_DRIVE_CREDENTIALS empty when using this.
GOOGLE_DRIVE_CREDENTIALS_JSON=

# Google Sheets — the spreadsheet ID from the sheet URL
GOOGLE_SHEET_ID=

# Google Drive folder IDs (from the folder URL)
INCOMING_FOLDER_ID=
PROCESSED_FOLDER_ID=
DUPLICATE_FOLDER_ID=
REJECTED_FOLDER_ID=

# Optional Google Apps Script Web App URL (used for Drive upload/download)
# Leave blank to use the standard Google Drive API path.
APPS_SCRIPT_URL=

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# NOTE: DEBUG level logs full API request payloads incl. resume text (PII).
# Use INFO in production.
LOG_LEVEL=INFO

# ── Company Enrichment toggle ─────────────────────────────────────────────────
# Set to false to skip all company enrichment (deterministic classification only)
ENRICHMENT_ENABLED=true

# ── Company Enrichment ─────────────────────────────────────────────────────────

# Domain resolution uses two free tiers only:
#   Tier 1 — Direct .com guess (free, instant, no API needed)
#   Tier 2 — DuckDuckGo Instant Answer API (free, no key, no rate limit)

# How many past companies to enrich alongside the current company (default: 2)
ENRICHMENT_PAST_COMPANY_LIMIT=2
